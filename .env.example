# ── Telegram ──
BOT_TOKEN=your_telegram_bot_token_from_botfather
ADMIN_IDS=123456789,987654321

# ── Database ──
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/drsub

# ── SubExpress Partner API ──
SUBEXPRESS_API_KEY=your_subexpress_api_key
SUBEXPRESS_BASE_URL=https://api.subexpress.space

# ── Paystack ──
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# ── Pricing ──
USD_TO_NGN_RATE=1650

# ── Webhook (for receiving Paystack callbacks) ──
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_BASE_URL=https://yourdomain.com
